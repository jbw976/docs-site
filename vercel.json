{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash build.sh",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/examples/anthropic-messages-api{/}?",
      "destination": "/guides/anthropic-messages-api/",
      "permanent": true
    },
    {
      "source": "/examples/collecting-engine-metrics{/}?",
      "destination": "/platform/telemetry/",
      "permanent": true
    },
    { "source": "/examples{/}?", "destination": "/recipes/", "permanent": true },
    {
      "source": "/examples/:page{/}?",
      "destination": "/recipes/:page/",
      "permanent": true
    },
    {
      "source": "/guides/inference_guide{/}?",
      "destination": "/guides/inference-guide/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    {
      "source": "/:version(main|v\\d+\\.\\d+)/:path*",
      "destination": "/:version/404.html"
    }
  ],
  "functions": { "api/mcp.js": { "maxDuration": 15 } }
}
